# Copy to .env.local and fill in what you need. See README.md's "Deploy
# guide" section for what each of these does and where to get it — this
# file just lists them; the README explains them.

# --- Required for anything to run ---
DATABASE_URL=
SESSION_SECRET=
ENCRYPTION_KEY=

# --- Strava (required to connect an account and import activities) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Email (verification codes just log to the console without this) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Contact address and canonical URL (used by /privacy, /terms, and
# the QR code on shared PDF/PNG exports) ---
CONTACT_EMAIL=
SITE_URL=

# --- Google login (optional — "Continue with Google" errors without these) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Claude (powers the Overtraining Shield, training plan, its
# deviation check, and the race-day plan — those panels show a friendly
# error without this; the rest of the app is unaffected) ---
ANTHROPIC_API_KEY=

# --- Stripe billing (optional — upgrade buttons show "not configured"
# without these; Free tier and everything else still work) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Beta Pro trial length in days for new signups, 0 to disable.
# Must keep the NEXT_PUBLIC_ prefix — read client-side by the home page. ---
NEXT_PUBLIC_BETA_PRO_TRIAL_DAYS=90

# --- Admin module (/admin) — separate from user accounts entirely.
# Leave unset to disable admin login altogether. ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
